# Cache policy for the built SPA.
#
# Everything under /assets/ has a content hash in its filename, so a change
# produces a new URL: those files can be cached forever. Without this they are
# served with the asset-server default (`max-age=0, must-revalidate`), which
# costs a revalidation round trip per file on every page load.
#
# index.html must go the other way — it is the one file whose name does not
# change, and it is what points at the hashed assets, so it has to be revalidated
# or a client would keep loading a stale bundle forever.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/index.html
  Cache-Control: public, max-age=0, must-revalidate
